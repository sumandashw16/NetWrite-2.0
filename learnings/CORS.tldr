		},
		{
			"meta": {},
			"id": "binding:n0zEUl-YiZ_yhU-pI1tkN",
			"type": "arrow",
			"fromId": "shape:IrHuUmtkLAapq9UqwxrU4",
			"toId": "shape:I-2HT2EjStyvL5Eh9yx6m",
			"props": {
				"isPrecise": true,
				"isExact": false,
				"normalizedAnchor": {
					"x": 0.6149490373725934,
					"y": 0.131492234728026
